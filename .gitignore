@'
# Dependencies
node_modules
backend/node_modules

# Build files
dist
dist-ssr
*.local

# Environment files
.env
.env.local
.env.production

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
'@ | Out-File -FilePath ".gitignore" -Encoding utf8 -Force
.vercel
.env*.local
